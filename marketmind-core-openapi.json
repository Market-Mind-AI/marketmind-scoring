{"openapi":"3.1.0","info":{"title":"MarketMind Core API","description":"Orchestration service for MarketMind. Owns the product catalog, the coverage index (what data has already been collected and for which period), the deterministic indicator engine (Cap. 4) and the MOS engine (Cap. 5 — Entropy Weight + TOPSIS, computed per country, never aggregated across countries). Reads collection services' databases read-only and never writes to them. This service does NOT use LLMs to calculate or alter indicators, weights, or MOS — LLM use is limited to product identification (candidate text only) and explaining already-computed results.","version":"0.1.0"},"paths":{"/health":{"get":{"tags":["Health"],"summary":"Health Check","description":"Returns application status, own database connectivity, and read-only connectivity to the 4 collection services' databases (PyTrends, WorldBank, OECD, UNData).","operationId":"health_check_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthResponse"}}}}}}},"/coverage/check":{"post":{"tags":["Coverage"],"summary":"Check coverage (read-only)","description":"Reports which of the given gaps are already covered (fresh in coverage_index) without dispatching any collection. Callers that need to decide sync-vs-async handling before committing to a collection round-trip should call this first.","operationId":"check_coverage_coverage_check_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CoverageCheckRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CoverageCheckResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/jobs":{"post":{"tags":["Coverage"],"summary":"Check coverage and collect what's missing","description":"For each gap: skips it if already fresh, attaches to an in-flight task if another caller is already collecting the same gap (race dedup), or dispatches collection to the right sibling service and polls it to completion. Synchronous for Fase 1 — Fase 5 decides when this needs to move behind 202+SSE instead.","operationId":"create_job_jobs_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateJobRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/jobs/{job_id}":{"get":{"tags":["Coverage"],"summary":"Get job status","description":"Polling endpoint for a job dispatched via POST /jobs.","operationId":"get_job_jobs__job_id__get","parameters":[{"name":"job_id","in":"path","required":true,"schema":{"type":"string","title":"Job Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/catalog/resolve":{"post":{"tags":["Catalog"],"summary":"Resolve product identity","description":"Resolves free-text product identification (already extracted by an upstream LLM step, out of scope here) to a stable entity_key: exact alias -> fuzzy trigram -> embedding similarity -> create new entity. entity_key is always generated locally and never blocked by an external dependency.","operationId":"resolve_catalog_resolve_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CatalogResolveRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CatalogResolveResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/catalog/{entity_key}":{"get":{"tags":["Catalog"],"summary":"Get catalog entity","description":"Returns the entity and its aliases. merged_into is surfaced explicitly (not hidden) when this entity was merged into another — callers should follow it rather than treat the entity as current.","operationId":"get_entity_catalog__entity_key__get","parameters":[{"name":"entity_key","in":"path","required":true,"schema":{"type":"string","title":"Entity Key"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CatalogEntityResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/indicators/compute":{"post":{"tags":["Indicators"],"summary":"Compute Cap. 4 indicators","description":"Computes every applicable indicator for a country (and, if entity_key is given, the 5 product-specific PyTrends indicators plus the conditional Median Age Fit too), normalizes each against normalization_reference, and upserts into indicator_values.","operationId":"compute_indicators_indicators_compute_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ComputeIndicatorsRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ComputeIndicatorsResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/mos/compute":{"post":{"tags":["MOS"],"summary":"Compute MOS (Cap. 5)","description":"Computes MOS for a product across the given countries, one independent result per country (never aggregated). Requires indicator_values (Fase 3) and calibrated dimension weights (POST /admin/mos/refresh-weights) for the resolved period_key to already exist — this endpoint does not trigger collection or calibration itself.","operationId":"compute_mos_mos_compute_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ComputeMosRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ComputeMosResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/admin/reconciliation/run":{"post":{"tags":["Admin"],"summary":"Run coverage reconciliation","description":"Compares coverage_index against the 4 services' raw observation tables to catch drift. Low-priority/diagnostic — meant to be invoked periodically by an external cron/systemd timer, no in-process scheduler exists yet. See app/services/reconciliation_service.py for the exact scope (WorldBank/OECD/UNData only for Fase 1).","operationId":"run_reconciliation_admin_reconciliation_run_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReconciliationReportResponse"}}}}}}},"/admin/catalog/enrich-mid":{"post":{"tags":["Admin"],"summary":"Best-effort google_mid enrichment","description":"For up to `limit` entities missing google_mid: asks PyTrends for suggestions on canonical_title and picks the best deterministic match. Never blocks catalog resolution — see app/services/enrichment_service.py.","operationId":"enrich_mid_admin_catalog_enrich_mid_post","parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":20,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EnrichmentReportResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/admin/catalog/merge":{"post":{"tags":["Admin"],"summary":"Merge duplicate catalog entities","description":"Merges entities discovered to share the same (enriched) google_mid. Run after /admin/catalog/enrich-mid — see app/services/merge_service.py.","operationId":"merge_catalog_admin_catalog_merge_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MergeReportResponse"}}}}}}},"/admin/catalog/backfill-embeddings":{"post":{"tags":["Admin"],"summary":"Backfill missing catalog embeddings","description":"Computes embeddings for up to `limit` entities created while the embedding provider was unavailable or unconfigured. Safe to call repeatedly — see app/services/catalog_service.py.","operationId":"backfill_embeddings_admin_catalog_backfill_embeddings_post","parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":50,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BackfillEmbeddingsResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/admin/indicators/refresh-reference":{"post":{"tags":["Admin"],"summary":"Refresh normalization reference bounds","description":"Recomputes normalization_reference (p5/p95 percentile bounds) for the 9 empirical country-agnostic indicators against the reference population (the seeded countries table). Never overwrites an already-closed period — see app/services/reference_calculator_service.py.","operationId":"refresh_reference_admin_indicators_refresh_reference_post","parameters":[{"name":"period_key","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Period Key"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshReferenceResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/admin/mos/refresh-weights":{"post":{"tags":["Admin"],"summary":"Calibrate MOS dimension weights (Rank Reciprocal)","description":"Writes all 6 dimension weights for the given period using Rank Reciprocal (RR) over an explicit priority order (Demand > Macro Demand Structure > Market Size > Economic Readiness > Digital Readiness > Demographic Sustainability) — Rank Order Centroid (ROC) was used from 2026-07-03 (replacing Entropy Weight, which live testing showed repeatedly undervaluing Demand) until 2026-07-08, when adding the Macro Demand Structure dimension prompted switching to RR to narrow the Market Size / Economic Readiness gap without hand-picking weights. Weights are fixed (no indicator data is read), but still versioned by period_key and never overwrite an already-closed period, consistent with normalization_reference. See app/services/mos/rank_reciprocal.py.","operationId":"refresh_weights_admin_mos_refresh_weights_post","parameters":[{"name":"period_key","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Period Key"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshWeightsResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}}},"components":{"schemas":{"BackfillEmbeddingsResponse":{"properties":{"updated":{"type":"integer","title":"Updated"}},"type":"object","required":["updated"],"title":"BackfillEmbeddingsResponse"},"CatalogEntityResponse":{"properties":{"entity_key":{"type":"string","format":"uuid","title":"Entity Key"},"canonical_title":{"type":"string","title":"Canonical Title"},"google_mid":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Google Mid"},"google_type":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Google Type"},"category":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Category"},"merged_into":{"anyOf":[{"type":"string","format":"uuid"},{"type":"null"}],"title":"Merged Into"},"aliases":{"items":{"$ref":"#/components/schemas/ProductAliasItem"},"type":"array","title":"Aliases"}},"type":"object","required":["entity_key","canonical_title","google_mid","google_type","category","merged_into","aliases"],"title":"CatalogEntityResponse"},"CatalogResolveRequest":{"properties":{"text":{"type":"string","minLength":1,"title":"Text"},"source":{"type":"string","minLength":1,"title":"Source"},"category":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Category"},"target_age_min":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Target Age Min"},"target_age_max":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Target Age Max"}},"type":"object","required":["text","source"],"title":"CatalogResolveRequest"},"CatalogResolveResponse":{"properties":{"entity_key":{"type":"string","format":"uuid","title":"Entity Key"},"canonical_title":{"type":"string","title":"Canonical Title"},"method":{"type":"string","title":"Method"},"match_score":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Match Score"}},"type":"object","required":["entity_key","canonical_title","method"],"title":"CatalogResolveResponse"},"ComputeIndicatorsRequest":{"properties":{"country":{"type":"string","maxLength":3,"minLength":3,"title":"Country","description":"ISO3 country code"},"entity_key":{"anyOf":[{"type":"string","format":"uuid"},{"type":"null"}],"title":"Entity Key"},"period_key":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Period Key","description":"'YYYY-MM'; defaults to the current month"}},"type":"object","required":["country"],"title":"ComputeIndicatorsRequest"},"ComputeIndicatorsResponse":{"properties":{"results":{"items"