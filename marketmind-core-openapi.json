":["source","country","indicator_code","period_key"],"title":"CoverageGap","description":"One unit of coverage the caller wants checked and, if missing,\ncollected. Maps 1:1 to a coverage_index row and, if collection is\nneeded, to exactly one job_task / one external ingestion run.\n\n``collection_params`` carries whatever the target source needs beyond\ncountry/indicator_code to build its request (e.g. ``keyword`` for\nPyTrends, ``start_year``/``end_year`` for WorldBank/UNData) — see\napp/services/collection_client.py for the exact keys per source. The\nCore does not resolve these from the product catalog yet (Fase 2), so\ncallers must supply them explicitly."},"CreateJobRequest":{"properties":{"requested_by":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Requested By"},"gaps":{"items":{"$ref":"#/components/schemas/CoverageGap"},"type":"array","minItems":1,"title":"Gaps"}},"type":"object","required":["gaps"],"title":"CreateJobRequest"},"DataSource":{"type":"string","enum":["pytrends","worldbank","oecd","undata"],"title":"DataSource"},"EnrichmentReportResponse":{"properties":{"checked":{"type":"integer","title":"Checked"},"enriched":{"type":"integer","title":"Enriched"},"no_match":{"type":"integer","title":"No Match"},"failed":{"type":"integer","title":"Failed"}},"type":"object","required":["checked","enriched","no_match","failed"],"title":"EnrichmentReportResponse"},"ExternalSourceStatus":{"properties":{"source":{"type":"string","title":"Source"},"status":{"type":"string","title":"Status"}},"type":"object","required":["source","status"],"title":"ExternalSourceStatus"},"GapStatus":{"properties":{"source":{"$ref":"#/components/schemas/DataSource"},"entity_key":{"anyOf":[{"type":"string","format":"uuid"},{"type":"null"}],"title":"Entity Key"},"country":{"type":"string","title":"Country"},"indicator_code":{"type":"string","title":"Indicator Code"},"period_key":{"type":"string","title":"Period Key"},"covered":{"type":"boolean","title":"Covered"},"last_fetched_at"