APP_NAME=marketmind-core
APP_ENV=local
APP_PORT=8004

# Core's own database (internal container port; host-exposed port is set via
# DATABASE_PORT_HOST in docker-compose.yml, default 5436 — not needed here
# unless you want to override it)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=marketmind_core
DATABASE_USER=marketmind
DATABASE_PASSWORD=admin

# TLS da conexão Postgres: disable | require | verify-full.
# "disable" para o docker-compose local (sem listener TLS). O Azure Database
# for PostgreSQL Flexible Server recusa conexão em texto puro
# (require_secure_transport = ON), então lá precisa ser "require" no mínimo.
DATABASE_SSL_MODE=disable

PGADMIN_DEFAULT_EMAIL=admin@marketmind.dev
PGADMIN_DEFAULT_PASSWORD=admin

# --- Read-only connections to the 4 collection services ---
# IMPORTANT: these services' docker-compose networks are NOT shared with this
# one (each declares its own "marketmind-network" without `external: true`,
# so Docker Compose scopes it per-project). Core reaches them via their
# host-exposed Postgres ports instead. See README "Conectividade entre
# serviços" for the full explanation and the required manual steps:
#   1. Run scripts/create_readonly_roles.sql against each of the 4 databases.
#   2. Make sure each service's host-exposed Postgres port is distinct if you
#      run all of them at the same time (defaults below assume the values
#      recommended in that README section, NOT each service's own default).
# host.docker.internal is used because this app runs inside a container and
# needs to reach ports published on the host by the other services' containers.
PYTRENDS_DB_HOST=host.docker.internal
PYTRENDS_DB_PORT=5432
PYTRENDS_DB_NAME=marketmind_pytrends
PYTRENDS_DB_USER=marketmind_readonly
PYTRENDS_DB_PASSWORD=admin

WORLDBANK_DB_HOST=host.docker.internal
WORLDBANK_DB_PORT=5434
WORLDBANK_DB_NAME=marketmind_worldbank
WORLDBANK_DB_USER=marketmind_readonly
WORLDBANK_DB_PASSWORD=admin

OECD_DB_HOST=host.docker.internal
OECD_DB_PORT=5433
OECD_DB_NAME=marketmind_oecd
OECD_DB_USER=marketmind_readonly
OECD_DB_PASSWORD=admin

UNDATA_DB_HOST=host.docker.internal
UNDATA_DB_PORT=5435
UNDATA_DB_NAME=marketmind_united_nations_data
UNDATA_DB_USER=marketmind_readonly
UNDATA_DB_PASSWORD=admin

# --- HTTP APIs of the 4 collection services (Fase 1: on-demand collection) ---
# Same host.docker.internal + distinct-ports strategy as the DB connections
# above. Ports match each service's own .env (already made distinct there):
# pytrends=8000, oecd=8001, undata=8002, worldbank=8003.
PYTRENDS_API_BASE_URL=http://host.docker.internal:8000
WORLDBANK_API_BASE_URL=http://host.docker.internal:8003
OECD_API_BASE_URL=http://host.docker.internal:8001
UNDATA_API_BASE_URL=http://host.docker.internal:8002

COLLECTION_POLL_INTERVAL_SECONDS=2.0
COLLECTION_POLL_TIMEOUT_SECONDS=120.0
COLLECTION_DISPATCH_TIMEOUT_SECONDS=1800.0
DEFAULT_COVERAGE_TTL_DAYS=30

# --- Fase 2: product catalog resolution (embedding step) ---
# Stopgap: Anthropic has no first-party embeddings API (see
# app/core/config.py comment) — using OpenAI for now, planned move to a
# locally-hosted model later. Required for POST /catalog/resolve to reach
# its embedding fallback step; alias-exact and trigram matching work without it.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
CATALOG_TRIGRAM_SIMILARITY_THRESHOLD=0.4
CATALOG_EMBEDDING_DISTANCE_THRESHOLD=0.5

# --- Fase 5: photo-based product identification (POST /catalog/identify-image) ---
# Anthropic has a first-party vision endpoint (no stopgap here, unlike the
# OpenAI embeddings above). Required for POST /catalog/identify-image;
# POST /analyze and everything else work without it.
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-haiku-4-5-20251001

LOG_LEVEL=INFO

# LLM provider resolver (2026-07-22) — swap provider/model per site via env only.
# provider ∈ {claude, gpt, ollama}; ollama routes through marketmind-ollma-llm.
VISION_LLM_PROVIDER=ollama
VISION_LLM_MODEL=qwen3-vl:8b-instruct
# enrichment: fills the JSON vision left out (above all localized_markets) — a TEXT model.
ENRICHMENT_LLM_PROVIDER=ollama
ENRICHMENT_LLM_MODEL=qwen3:14b
# reference_market: chooses the biggest-market candidates — needs real market knowledge,
# so defaults to a cloud LLM (the local model doesn't know actual market sizes).
REFERENCE_MARKET_LLM_PROVIDER=claude
REFERENCE_MARKET_LLM_MODEL=claude-haiku-4-5-20251001
EXPLANATION_LLM_PROVIDER=ollama
EXPLANATION_LLM_MODEL=gemma4:12b

# marketmind-orchestrator API base URL
USE_NEW_ORCHESTRATOR=False
ORCHESTRATOR_API_BASE_URL=http://localhost:8081
