APP_NAME=marketmind-core
APP_ENV=local
APP_PORT=8004

# Core's own database (internal container port; host-exposed port is set via
# DATABASE_PORT_HOST in docker-compose.yml, default 5436 — not needed here
# unless you want to override it)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=marketmind_core
DATABASE_USER=marketmind
DATABASE_PASSWORD=admin

# TLS da conexão Postgres: disable | require | verify-full.
# "disable" para o docker-compose local (sem listener TLS). O Azure Database
# for PostgreSQL Flexible Server recusa conexão em texto puro
# (require_secure_transport = ON), então lá precisa ser "require" no mínimo.
DATABASE_SSL_MODE=disable

PGADMIN_DEFAULT_EMAIL=admin@marketmind.dev
PGADMIN_DEFAULT_PASSWORD=admin

# --- HTTP APIs of the 4 collection services ---
# Everything goes through these: dispatching a collection, polling an ingestion
# run, and READING the data they hold. This service no longer opens their
# databases.
# host.docker.internal is used because this app runs in a container and reaches
# ports the other services publish on the host. The ports are distinct so all
# four can run at once: pytrends=8000, oecd=8001, undata=8002, worldbank=8003.
PYTRENDS_API_BASE_URL=http://host.docker.internal:8000
WORLDBANK_API_BASE_URL=http://host.docker.internal:8003
OECD_API_BASE_URL=http://host.docker.internal:8001
UNDATA_API_BASE_URL=http://host.docker.internal:8002

COLLECTION_POLL_INTERVAL_SECONDS=2.0
COLLECTION_POLL_TIMEOUT_SECONDS=120.0
COLLECTION_DISPATCH_TIMEOUT_SECONDS=1800.0
DEFAULT_COVERAGE_TTL_DAYS=30

# --- Fase 2: product catalog resolution (embedding step) ---
# Stopgap: Anthropic has no first-party embeddings API (see
# app/core/config.py comment) — using OpenAI for now, planned move to a
# locally-hosted model later. Required for POST /catalog/resolve to reach
# its embedding fallback step; alias-exact and trigram matching work without it.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
CATALOG_TRIGRAM_SIMILARITY_THRESHOLD=0.4
CATALOG_EMBEDDING_DISTANCE_THRESHOLD=0.5

# --- Busca semântica do catálogo (passo 3a: recall via pgvector + HNSW) ---
# Voyage AI gera os embeddings; o vetor só escolhe os candidatos que vão ao
# LLM, nunca aceita um match sozinho. Chave em https://dash.voyageai.com
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4
VOYAGE_EMBEDDING_DIMENSIONS=1024
# Veto por produto antagônico: abaixo desta margem o passo 2 não decide por forma
# e manda a consulta ao LLM. Calibrado em evaluation/ (joelho da curva precisão x cobertura).
CATALOG_SEMANTIC_ABSTENTION_MARGIN=0.035

# --- Anthropic ---
# Every LLM call site runs on Claude (see the resolver block below), so this key
# is load-bearing for POST /catalog/identify-image, /analyze's enrichment and
# reference-market steps, and the MOS narrative. The model per site is chosen by
# <SITE>_LLM_MODEL below — there is no separate ANTHROPIC_VISION_MODEL.
ANTHROPIC_API_KEY=
# Prompt-cache lifetime for the system prompts: 1h (default; analyses start
# 5-60 min apart) or 5m (cheaper writes, for bursts such as an eval run).
LLM_PROMPT_CACHE_TTL=1h

# --- Tracing ---
# Every model call becomes a generation in Langfuse: the prompt, the answer, the
# tokens and the latency. Joined to the orchestrator's trace for the analysis
# that caused it. Unset means untraced, which is allowed.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

LOG_LEVEL=INFO

# LLM provider resolver (2026-07-22) — swap provider/model per site via env only.
# provider ∈ {claude, gpt, ollama}; ollama routes through marketmind-ollma-llm.
# Every site is on Claude as of 2026-08-13 (user decision: this project ships
# published with no OpenAI dependency). Keep vision on a capable model — the
# identify-image `markets` payload is large structured output and small models
# degenerate on it (see app/core/config.py).
VISION_LLM_PROVIDER=claude
VISION_LLM_MODEL=claude-opus-5
# enrichment: fills the JSON vision left out (above all localized_markets) — a TEXT model.
ENRICHMENT_LLM_PROVIDER=claude
ENRICHMENT_LLM_MODEL=claude-opus-5
# reference_market: chooses the biggest-market candidates — needs real market knowledge,
# so it must stay on a cloud LLM (a local model doesn't know actual market sizes).
REFERENCE_MARKET_LLM_PROVIDER=claude
REFERENCE_MARKET_LLM_MODEL=claude-opus-5
EXPLANATION_LLM_PROVIDER=claude
EXPLANATION_LLM_MODEL=claude-opus-5

# Shared secret the orchestrator sends on /internal/* calls. Those routes
# write — they register analyses, collect, and complete requests — so they are
# not for the browser. Empty means every /internal/* call is refused, which is
# deliberate: a secret left unset that waved calls through would look, from
# outside a running deployment, exactly like one configured correctly.
INTERNAL_API_TOKEN=

# marketmind-orchestrator API base URL
ORCHESTRATOR_API_BASE_URL=http://localhost:8081
