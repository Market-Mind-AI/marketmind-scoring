{
  "dataset": "catalog-match",
  "description": "The LLM step that decides whether a query names the same product as a catalog entry. Several cases must answer 'none'.",
  "items": [
    {"id": "cm-alias-air-fryer", "input": {"text": "freidora de aire", "candidates": [{"title": "air fryer", "category": "Kitchen Appliances"}, {"title": "deep fryer", "category": "Kitchen Appliances"}]}, "expected_output": {"expected_title": "air fryer"}},
    {"id": "cm-oil-deep-fryer", "input": {"text": "fritadeira de óleo", "candidates": [{"title": "air fryer", "category": "Kitchen Appliances", "excluded_terms": ["de óleo", "fritadeira de óleo"]}, {"title": "deep fryer", "category": "Kitchen Appliances", "search_terms": ["fritadeira de óleo", "freidora de aceite"]}]}, "expected_output": {"expected_title": "deep fryer"}, "note": "An oil deep-fryer is not an air fryer."},
    {"id": "cm-pork-picanha", "input": {"text": "picanha suína", "candidates": [{"title": "picanha", "category": "Beef", "search_terms": ["picanha bovina", "picanha angus"], "excluded_terms": ["suína", "de porco"]}, {"title": "pork shoulder", "category": "Pork"}]}, "expected_output": {"expected_title": null}, "note": "Pork picanha is a different product from beef picanha, and no candidate is it."},
    {"id": "cm-yerba-buena", "input": {"text": "yerba buena", "candidates": [{"title": "yerba mate", "category": "Tea & Infusions", "search_terms": ["yerba mate", "mate"], "excluded_terms": ["yerba buena", "hierbabuena"]}, {"title": "mint", "category": "Herbs", "search_terms": ["hierbabuena", "yerba buena", "menta"]}]}, "expected_output": {"expected_title": "mint"}},
    {"id": "cm-coconut-oil", "input": {"text": "aceite de coco orgánico", "candidates": [{"title": "extra virgin olive oil", "category": "Cooking Oils"}, {"title": "coconut oil", "category": "Cooking Oils"}]}, "expected_output": {"expected_title": "coconut oil"}},
    {"id": "cm-brand-partition", "input": {"text": "Cardhu 12", "candidates": [{"title": "single malt whisky", "category": "Spirits"}, {"title": "Cardhu single malt whisky", "category": "Spirits"}]}, "expected_output": {"expected_title": "Cardhu single malt whisky"}, "note": "A query naming a brand resolves to that brand's entry, not the generic family."},
    {"id": "cm-different-brand", "input": {"text": "Nespresso Vertuo capsules", "candidates": [{"title": "Dolce Gusto capsules", "category": "Coffee"}]}, "expected_output": {"expected_title": null}, "note": "A different brand is a different product: the brand decides identity."},
    {"id": "cm-translation", "input": {"text": "café colombiano en grano", "candidates": [{"title": "colombian coffee", "category": "Coffee"}]}, "expected_output": {"expected_title": "colombian coffee"}},
    {"id": "cm-japanese-script", "input": {"text": "カーデュ 12年", "candidates": [{"title": "Cardhu single malt whisky", "category": "Spirits"}, {"title": "green tea", "category": "Tea"}]}, "expected_output": {"expected_title": "Cardhu single malt whisky"}},
    {"id": "cm-accessory-vs-appliance", "input": {"text": "papel para airfryer", "candidates": [{"title": "air fryer", "category": "Kitchen Appliances"}, {"title": "air fryer liners", "category": "Kitchen Accessories"}]}, "expected_output": {"expected_title": "air fryer liners"}},
    {"id": "cm-size-variant", "input": {"text": "air fryer 8L", "candidates": [{"title": "air fryer", "category": "Kitchen Appliances"}]}, "expected_output": {"expected_title": "air fryer"}, "note": "A size variant is the same product."},
    {"id": "cm-homonym-apple", "input": {"text": "manzana fresca", "candidates": [{"title": "Apple iPhone", "category": "Smartphones"}, {"title": "apple juice", "category": "Beverages"}]}, "expected_output": {"expected_title": null}},
    {"id": "cm-spare-part", "input": {"text": "filtro HEPA para robot aspirador", "candidates": [{"title": "robot vacuum", "category": "Home Appliances"}, {"title": "HEPA filter", "category": "Appliance Parts", "search_terms": ["filtro hepa", "filtro para aspiradora"]}]}, "expected_output": {"expected_title": "HEPA filter"}},
    {"id": "cm-sunscreen-vs-aftersun", "input": {"text": "protector solar SPF 50", "candidates": [{"title": "after sun lotion", "category": "Skincare"}, {"title": "sunscreen", "category": "Skincare"}]}, "expected_output": {"expected_title": "sunscreen"}},
    {"id": "cm-unrelated-supplements", "input": {"text": "creatina monohidratada", "candidates": [{"title": "whey protein", "category": "Supplements"}, {"title": "BCAA", "category": "Supplements"}]}, "expected_output": {"expected_title": null}}
  ]
}
